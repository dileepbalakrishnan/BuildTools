      <param name="value">The value of the metadata property.</param>
    </member>
    <member name="M:System.Runtime.DurableInstancing.InstancePersistenceContext.WroteInstanceOwnerMetadataValue(System.Xml.Linq.XName,System.Runtime.DurableInstancing.Instanc=≥Gû␀Ä␀ÄeValue)">
