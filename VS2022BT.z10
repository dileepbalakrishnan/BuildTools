    <member name="F:System.Web.UI.WebControls.ScrollBars.Horizontal">
      <summary>Displays only a horizontal scroll bar.</summary>
    </member>
    <member name="F:System.Web.UI.WebControls.ScrollBars.Vertical">
      <summary>Displays only a vertical scroll bar.</summary>
    </member>
    <member name="F:System.Web.UI.WebControls.ScrollBars.Both">
      <summary>Displays both a horizontal and a vertical scroll bar.</summary>
    </member>
    <member name="F:System.Web.UI.WebControls.ScrollBars.Auto">
