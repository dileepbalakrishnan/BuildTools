      <returns>The rate at which this clock's time is current progressing, compared to real-world time. If the clock is stopped, this property returns <see langword="null" />.</returns>
    </member>
    <member name="P:System.Windows.Media.Animation.Clock.CurrentGlobalTime">
      <summary>Gets the current global time, as established by the WPF timing system.Â </summary>
