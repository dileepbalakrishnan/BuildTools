    </member>
    <member name="P:System.ServiceModel.Configuration.HttpTransportElement.KeepAliveEnabled">
      <summary>Gets or sets a <see langword="Boolean" /> value that indicates whether to make a persistent connection to the internet resource.</summary>
      <returns>
          <see langword="true" /> if a persistent connection to the internet resource is maintained; otherwise, <see langword="false" />.</returns>
