      <param name="transactionAborted">The reference parameter that returns <see langword="true" /> if the transaction was aborted during the callback method; otherwise, <see langword="false" />.Â </param>
      <exception cref="T:System.PlatformNotSupportedException">The operating system is not WindowsÂ NT or later.</exception>
      <exception cref="T:System.Web.HttpException">The transacted code cannot be executed.</exception>
    </member>
