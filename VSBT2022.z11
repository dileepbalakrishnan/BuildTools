      <returns>
        <see langword="true" /> if the method was successful; otherwise, <see langword="false" />.</returns>
    </member>
    <member name="M:Microsoft.Build.Tasks.Hosting.ICscHostObject.SetCheckForOverflowUnderflow(System.Boolean)">
