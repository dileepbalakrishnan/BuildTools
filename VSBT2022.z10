    <member name="T:System.Activities.Presentation.PropertyEditing.PropertyContainerEditMode">
      <summary>Contains the different edit modes of a <see cref="T:System.Activities.Presentation.PropertyEditing.PropertyContainerEditMode" />.</summary>
