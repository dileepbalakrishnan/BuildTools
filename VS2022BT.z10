      <param name="lockId">The lock identifier for the current request. </param>
      <param name="newItem">
            <see langword="true" /> to identify the session item as a new item; <see langword="false" /> to identify the session item as an existing item.</param>
    </member>
    <member name="M:System.Web.SessionState.SessionStateStoreProviderBase.SetItemEx]¤Bº␀€␀€pireCallback(System.Web.SessionState.SessionStateItemExpireCallback)">
