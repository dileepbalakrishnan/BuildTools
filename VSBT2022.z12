      <returns>A <see langword="double" /> value.</returns>
    </member>
    <member name="P:System.Web.UI.DataVisualization.Charting.ZTestResult.FirstSeriesVariance">
      <summary>Gets the variance of the first series.</summary>
      <returns>A <see langword="double" /> value.</returns>
