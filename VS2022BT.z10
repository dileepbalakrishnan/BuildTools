    <member name="P:System.ServiceModel.Configuration.HttpTransportSecurityElement.ExtendedProtectionPolicy">
      <summary>Gets or sets an <see cref="T:System.Security.Authentication.ExtendedProtection.Configuration.ExtendedProtectionPolicyElement" /> instance which contains the configuration settings to use for extended protection for a session.</summary>
      <returns>An <see cref="T:System.Security.Authentication.ExtendedProtection.Configuration.ExtendedProtectionPolicyElement" /> instance which contains the configuration settings to use for extended protection for a session.</returns>
    </member>
