      <shÎ÷␀Ä␀Äummary>Extracts the value of the data control field from the current table cell and adds the value to the specified <see cref="T:System.Collections.IDictionary" /> collection.</summary>
      <param name="dictionary">An <see cref="T:System.Collections.Specialized.IOrderedDictionary" />.</param>
