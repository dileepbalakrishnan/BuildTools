      <returns>The <see cref="T:System.Security.Authentication.ExtendedProtection.Configuration.ExtendedProtectionPolicyElement" /> which contains the configuration settings to use for extended protection for a session.</returns>
    </member>
    <member name="P:System.ServiceModel.Configuration.HttpTransportElement.HostNameComparisonMode">
