    </member>
    <member name="P:System.Windows.Diagnostics.VisualTreeChangeEventArgs.ChildIndex">
      <summary>Gets the index in the Parent element's children where the Child element is located when the add or remove operation is complete. On a removal, this value will always be -1.</summary>
      <returns>The index in the Parent element's children where the Child element is located when the add or remove operation is complete.</returns>
    </member>
    <member name="P:System.Windows.Diagnostics.VisualTreeChangeEventArgs.Parent">
      <summary>Gets the <see cref="T:System.Windows.DependencyObject" /> to which an element (Child) was either added or removed.</summary>
