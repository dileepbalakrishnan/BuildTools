    <member name="P:System.Data.Common.DbParameter.SourceColumnNullMapping">
      <summary>Sets oru√␀õ␀Ä␀Ä gets a value which indicates whether the source column is nullable. This allows <see cref="T:System.Data.Common.DbCommandBuilder" /> to correctly generate Update statements for nullable columns.</summary>
