          <see langword="true" /> if at least one touch is captured to this element or any child elements in its visual tree; otherwise, <see langword="false" />. </returns>
    </member>
    <member name="P:System.Windows.UIElement3D.AreAnyTouchesDirectlyOver">
      <summary>Gets a value that indicates whether at least one touch is pressed over this element.</summary>
      <returns>
          <see langword="true" /> if at least one touch is pressed over this element; otherwise, <see langword="false" />. </returns>
    </member>
