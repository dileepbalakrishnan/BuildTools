<doc>
  <assembly>
    <name>System.Web</name>
  </assembly>
  <members>
    <member name="E:System.Web.Compilation.ClientBuildManager.AppDomainShutdown">
      <summary>Occurs when an application domain is shut down. </summary>
    </member>
