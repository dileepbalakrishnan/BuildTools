      <param name="addrKind">The addre˝Çñ␀Ä␀Äss types for <paramref name="addr1" />, <paramref name="addr2" />, and <paramref name="addr3" /> using <see cref="T:System.Diagnostics.SymbolStore.SymAddressKind" />.</param>
