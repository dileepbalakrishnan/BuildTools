    <member name="T:J#Number">
      <summary>Extends the base ECMAScript (JavaScript) Number functionality with static and instance methods.</summary>
      <exception cref="Sys.ArgumentException">
        <paramref name="format" /> is invalid.
      </exception>
    </member>
