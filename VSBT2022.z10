      <returns>
          <see langword="true" /> if the signature verifies for the hash; otherwise, <see langword="false" />. </returns>
      <exception cref="T:System.ArgumentNullException">
              <paramref name="Cé©␀Ä␀Ähash" /> is <see langword="null" />. -or-
