    <member name="F:System.Windows.Markup.Localizer.BamlLocalizerError.DuplicateUid">
      <summary>More than one element has the same <see cref="P:System.Windows.Markup.Localizer.BamlLoc†ÙóΩ␀Ä␀ÄalizableResourceKey.Uid" /> value.</summary>
    </member>
