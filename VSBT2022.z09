      <exception cref="T:System.InvalidOperationException">An <see cref="T:System.Xml.XmlReader" /> method was called before a previous asynchronous operation finished. In this case, <see cref="T:System.InvalidOperationException" /> is thrown with the message â€œAn asynchronous operation is already in progress.â€</exception>
      <exception cref="T:System.ArgumentNullException">Both parameter values are <see langword="null" />.</exception>
    </member>
