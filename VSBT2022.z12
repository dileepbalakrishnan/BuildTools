 <paramref name="a" /> =  +Infinity  

 <paramref name="newBase" />&gt; 1  

  +Infinity  

 <paramref name="a" /> = 1  

 <paramref name="newBase" /> = 0  

  0  

 <paramref name="a" /> = 1  

 <paramref name="newBase" /> = +Infinity  

  0</returns>
    </member>
