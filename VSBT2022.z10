        <summary>Attaches a handler to an event in an <see cref="T:J#Sys.EventHandlerList" /> instance and adds the event to the list if it is not already present.</summary>
        <param name="id">A string that specifies the event.</param>
        <param name="handler">The name of the method to handle the event.</param>
