    </member>
    <member name="P:System.ServiceModel.Configuration.MsmqElementBase.ReceiveContextEnabled">
      <summary>Gets or sets a value that specifies if receive context for processing messages in queues is enabled.</summary>
      <returns>
          <see langword="true" /> if receive context for processing messages in queues is enabled; otherwise, <see langword="false" />.</returns>
    </member>
    <member name="P:System.ServiceModel.Configuration.MsmqElementBase.ReceiveErrorHandling">
      <summary>Gets or sets an enumeration value thÛP¯␀Ä␀Äat specifies how poison and nondispatchable messages are handled.</summary>
      <returns>A <see cref="T:System.ServiceModel.ReceiveErrorHandling" /> value that specifies how poison and nondispatchable messages are handled.</returns>
