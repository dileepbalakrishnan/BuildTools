      <summary>Text is rendered with bilevel anti-aliasing.</summary>
    </member>
    <member name="F:System.Windows.Media.TextRenderingMode.Grayscale">
      <summary>Text is rendered with grayscale anti-aliasing.</summary>
    </member>
