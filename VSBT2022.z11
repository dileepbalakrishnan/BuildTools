    <member name="M:System.Windows.Diagnostics.VisualTreeChangeEventArgs.#ctor(System.Windows.DependencyObject,System.Windows.DependencyObject,System.Int32,System.Windows.Diagnostics.VisualTreeChangeType)">
      <summary>Initializes a new instance of the <see cref="T:System.Windows.Diagnostics.VisualTreeChangeEventArgs" /> class.</summary>
      <param name="parent">The <see cref="T:System.Windows.DependencyObject" /> to which an element (Child) was either added or removed.</param>
      <param name="child">The <see cref="T:System.Windows.DependencyObject" /> that was added to or removed from another element (Parent).</param>
      <param name="childIndex">The index in the Parent element's children where the Child element is located when the add or remove operation is complete.</param>
      <param name="changeType">A value that indicates whether the Child element was added to another element (Parent) or removed.</param>
    </member>
    <member name="P:System.Windows.Diagnostics.VisualTreeChangeEventArgs.ChangeType">
