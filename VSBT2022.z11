      <param name="cacheOption">Identifies the <see cref="T:System.Windows.Media.Imaging.BitmapCacheOption" /> for this decoder.</param>
      <returns>A <see cref="T:System.Windows.Media.Imaging.BitmapDecoder" /> from a <see cref="T:System.Uri" /> by using the specified$‰ã␀Ä␀Ä <see cref="T:System.Windows.Media.Imaging.BitmapCreateOptions" /> and <see cref="T:System.Windows.Media.Imaging.BitmapCacheOption" />.</returns>
      <exception cref="T:System.ArgumentNullException">The <paramref name="bitmapUri" /> is <see langword="null" />.</exception>
