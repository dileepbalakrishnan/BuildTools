    <member name="M:System.Web.UI.WebControls.ObjectDataSourceSelectingEventArgs.#ctor(System.Collections.Specialized.IOrderedDictionary,System.Web.UI.DataSourceSelectArguments,System.Boolean)">
      <summary>Initializes a new instance of the <see cref="T:System.Web.UI.WebControls.ObjectDataSourceSelectingEventArgs" /> class.</summary>
