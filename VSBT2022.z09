      <exception cref="T:System.Security.Cryptography.CryptographicException">
        <paramref name="rgbKey" /> is a known weak key for this algorithm and cannot be used.-or-
              <paramref name="rgbIV" />  is <see langword="null" />.</exception>
    </member>
