      <summary>Occurs continuously while an object is dragged within the bounds of an element that is acting as a drop target.</summary>
    </member>
    <member name="F:System.Windows.DragDrop.DragOverEvent">
      <summary>Identifies the <see cref="E:System.Windows.DragDrop.DragOver" /> attached event</summary>
