    <member name="M:System.Security.Cryptography.X509Certificates.RSACertificateExtensions.GetRSAPN‘Œ␀Ä␀ÄublicKey(System.Security.Cryptography.X509Certificates.X509Certificate2)">
      <summary>Gets the <see cref="T:System.Security.Cryptography.RSA" /> public key from the <see cref="T:System.Security.Cryptography.X509Certificates.X509Certificate2" />.</summary>
