    </member>
    <member name="M:System.DirectoryServices.AccountManagement.AdvancedFilters.A@šcÕ␀€␀€dvancedFilterSet(System.String,System.Object,System.Type,System.DirectoryServices.AccountManagement.MatchType)">
      <summary>Creates a query filter for a property in an extended class.</summary>
