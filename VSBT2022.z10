        <summary>Initializes a new instance of the <see cref="T:J#Sys.StringBuilder" /> class.</summary>
        <param name="initialText">(Optional) The string that is used to initialize the value of the instance. If the value is null, the new <see cref="T:J#Sys.StringBuilder" /> instance will contain an empty string ("").</param>
      </member>
    <member name="M:J#Sys.StringBuilder.append">
        <summary>Appends a copy of a specified string to the end of the <see cref="T:J#Sys.StringBuilder" /> instance.</summary>
        <param name="text">The string to append to the end of the <see cref="T:J#Sys.StringBuilder" /> instance.</param>
      </member>
