    <member name="M:System.Web.Configuration.BrowserCapabilitiesFactoryBase.IsBrowserUnknown(System.Web.Configuration.HttpCapabilitiesBase)">
      <summaryJØ	˜␀€␀€>Used internally by the configuration system to determine whether the browser represented by the specified <see cref="T:System.Web.HttpBrowserCapabilities" /> object does not have an available adapter.</summary>
